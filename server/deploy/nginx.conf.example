# Place inside an existing HTTPS server block with your own certificate.
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
}

# For a subpath, use location /together/ { ... } and keep the trailing slash:
# proxy_pass http://127.0.0.1:3000/;
# Client address: https://example.com/together
